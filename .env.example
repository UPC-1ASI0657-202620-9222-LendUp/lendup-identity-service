# Configuración local. Nunca publicar el archivo .env real.
PORT=8081
CORS_ORIGINS=http://localhost:5173

# Credenciales locales independientes de Catálogo (puerto 3309).
DB_HOST=127.0.0.1
DB_PORT=3309
DB_NAME=lendup_identidad
DB_USERNAME=lendup_identidad
DB_PASSWORD=CAMBIAR_CONTRASENA_MYSQL
MYSQL_ROOT_PASSWORD=CAMBIAR_CONTRASENA_ROOT

# Debe coincidir con el proyecto utilizado por Catálogo.
FIREBASE_PROJECT_ID=lendup-desarrollo
# En Windows PowerShell se puede establecer GOOGLE_APPLICATION_CREDENTIALS
# con la ruta absoluta al JSON privado, fuera del repositorio.
# GOOGLE_APPLICATION_CREDENTIALS=
TERMS_VERSION=2026-10-04
